{
  "name": "@back-in-stock/plugin-source-fanatec",
  "version": "0.1.0",
  "description": "Fanatec source for Back in stock !: stock, price (discount included), name and photo of a product page.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@back-in-stock/source": "./src/index.ts",
