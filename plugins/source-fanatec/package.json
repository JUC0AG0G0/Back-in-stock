    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@back-in-stock/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
